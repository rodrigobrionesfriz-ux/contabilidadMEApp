# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Project Settings → API). La clave "publishable" es pública por diseño: la seguridad la da el RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# URL pública del sitio (para los enlaces de confirmación y recuperación de clave)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
